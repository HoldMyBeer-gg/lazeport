{
  "name": "lazeport-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-node.js && node scripts/convert-to-webp.js && node scripts/generate-favicon.js && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "marked": "^17.0.6",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.15",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "sharp": "^0.35.5",
    "vite": "^6.4.4"
  }
}
