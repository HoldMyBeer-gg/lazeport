# Copy this to data/.env on the production server and fill in real values.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_hex(32))"

SESSION_SECRET_KEY=replace-with-random-64-char-hex
APP_SECRET_KEY=replace-with-random-64-char-hex
PUBLIC_APP_URL=https://lazeport.pwn.zone

# Outbound URL policy (SSRF guard). By default, user-supplied LLM base URLs and
# Jira URLs that resolve to loopback/private/link-local addresses are refused.
# The built-in Ollama default (http://localhost:11434) is always allowed.
# Enable these only for self-hosted deployments that need LAN-hosted services.
#ALLOW_PRIVATE_LLM_URLS=1
#ALLOW_PRIVATE_JIRA_URLS=1
